# Backend
BACKEND_PORT=8000
SQLITE_PATH=/data/dashboard.db

# MCP
MCP_PORT=8001
DISPLAY=:0
DISPLAY_OUTPUT=eDP-1
MCP_RATE_LIMIT_PER_MINUTE=60

# Cloudflare Access (MCP-Server validiert das Assertion)
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=your-access-audience-tag

# Garmin
GARMIN_EMAIL=user@example.com
GARMIN_PASSWORD=change-me
GARMIN_SYNC_INTERVAL_SECONDS=1200
GARMIN_BACKOFF_BASE_SECONDS=60
GARMIN_BACKOFF_MAX_ATTEMPTS=5
GARMIN_BACKOFF_CAP_SECONDS=3600
GARMIN_TOKEN_DIR=/data/token
# Nur Verifikation ohne echten Garmin-Account (schreibt synthetische Cache-Zeilen):
GARMIN_SYNC_MOCK=0

# Garmin-Schreibpfad (WP-P2-5): interner Write-Endpunkt von `garmin-sync`
# (Compose-Netz, Port 8002, kein Host-Port). Default intern -> nicht noetig.
# GARMIN_SYNC_WRITE_URL=http://garmin-sync:8002
# GARMIN_SYNC_WRITE_TIMEOUT_SECONDS=10

# Wetter (Open-Meteo)
WEATHER_LATITUDE=48.1374
WEATHER_LONGITUDE=11.5755
WEATHER_TIMEZONE=Europe/Berlin
WEATHER_CACHE_TTL_SECONDS=600

# Baikal-Kalender (WP-P2-1, Pull-Adapter, HTTP Basic)
BAIKAL_URL=
BAIKAL_USERNAME=
BAIKAL_PASSWORD=
BAIKAL_CACHE_TTL_SECONDS=600
BAIKAL_DAYS_AHEAD=7
BAIKAL_TIMEOUT_SECONDS=10

# Grocy-Bestand (WP-P2-2, Pull-Adapter, Grocy >= 3.3)
GROCY_URL=
GROCY_API_KEY=
GROCY_CACHE_TTL_SECONDS=600
GROCY_TIMEOUT_SECONDS=10

# Mealie-Wochenplan (WP-P2-3, Pull-Adapter, Mealie v2, Bearer-Token)
MEALIE_URL=
MEALIE_API_TOKEN=
MEALIE_CACHE_TTL_SECONDS=600
MEALIE_DAYS_AHEAD=7
MEALIE_TIMEOUT_SECONDS=10

# Widget-Installation (WP-P2-4, Zip-/Git-Upload). Zielordner ist das
# Schreib-Volume `widgets-data` (siehe compose.yaml).
WIDGETS_INSTALL_DIR=/data/widgets
WIDGETS_MAX_ZIP_BYTES=10485760
WIDGETS_MAX_UNCOMPRESSED_BYTES=52428800

# Grid
GRID_COLUMNS=12
GRID_ROW_HEIGHT_PX=96
GRID_GAP_PX=8
