{
  "id": "garmin-vitals",
  "name": "Vitalwerte",
  "version": "1.0.0",
  "author": "Marex Agent Developer",
  "description": "Tageswerte aus GET /api/garmin/vitals: Schritte, Ruhepuls, Stress, Body Battery, Etagen und aktive Kalorien (G.5 kind=vitals).",
  "category": "health",
  "icon": "icon.svg",
  "permissions": ["garmin_cache"],
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "steps_target": {
        "type": "integer",
        "default": 10000,
        "minimum": 1,
        "description": "Schrittziel pro Tag (Ziel-Linie der Kachel)."
      }
    }
  },
  "default_size": { "w": 4, "h": 3 },
  "min_size": { "w": 3, "h": 3 },
  "max_instances": 1,
  "tags": ["garmin", "vitalwerte", "schritte", "health"]
}
