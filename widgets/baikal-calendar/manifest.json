{
  "id": "baikal-calendar",
  "name": "Kalender",
  "version": "1.0.0",
  "author": "Marex Agent Developer",
  "description": "Kommende Termine aus Baikal (CalDAV): Titel und Startzeit aus GET /api/baikal/events (600 s gecacht).",
  "category": "productivity",
  "icon": "icon.svg",
  "permissions": ["baikal"],
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20,
        "default": 6,
        "description": "Maximal in der Liste angezeigte Termine."
      }
    }
  },
  "default_size": { "w": 4, "h": 4 },
  "min_size": { "w": 3, "h": 3 },
  "max_instances": 1,
  "tags": ["baikal", "kalender", "caldav", "termine"]
}
