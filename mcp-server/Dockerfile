FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# x11-xserver-utils liefert xset und xrandr fuer die Display-Steuerung (J.2),
# curl wird vom Compose-Healthcheck benoetigt.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl x11-xserver-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml ./
COPY app ./app
RUN pip install .

EXPOSE 8001

# Im Container bindet der Prozess auf 0.0.0.0; die Beschraenkung auf
# 127.0.0.1 passiert ueber das Compose-Portmapping (F.1).
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001"]
